{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ObligationCreate": {
        "additionalProperties": false,
        "description": "Integration-safe obligation creation request.",
        "properties": {
          "contract_id": {
            "minLength": 1,
            "title": "Contract Id",
            "type": "string"
          },
          "description": {
            "default": "",
            "maxLength": 4000,
            "title": "Description",
            "type": "string"
          },
          "due_date": {
            "default": "",
            "maxLength": 10,
            "title": "Due Date",
            "type": "string"
          },
          "recurrence": {
            "default": "none",
            "pattern": "^(none|monthly|quarterly|annual)$",
            "title": "Recurrence",
            "type": "string"
          },
          "title": {
            "maxLength": 240,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "contract_id",
          "title"
        ],
        "title": "ObligationCreate",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "FastCLM API token": {
        "description": "All contract data requires `Authorization: Bearer <token>` and an `X-FastCLM-Organisation` workspace identifier.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
