# Application
FASTCLM_SECRET=replace-with-a-long-random-value
FASTCLM_ENCRYPTION_KEY=
FASTCLM_PORT=5025
FASTCLM_PUBLIC_URL=http://localhost:5025
FASTCLM_ENV_LABEL=Local
FASTCLM_DATA_DIR=./data
FASTCLM_DB=./data/fastclm.sqlite
FASTCLM_UPLOAD_DIR=./data/uploads
# Source-object backend: local or s3. S3 supports AWS and compatible endpoints.
FASTCLM_STORAGE_BACKEND=local
FASTCLM_S3_BUCKET=
FASTCLM_S3_ENDPOINT_URL=
FASTCLM_S3_REGION=eu-west-1
FASTCLM_S3_ACCESS_KEY_ID=
FASTCLM_S3_SECRET_ACCESS_KEY=
FASTCLM_S3_PREFIX=fastclm
FASTCLM_S3_KMS_KEY_ID=
FASTCLM_CLAMAV_HOST=
FASTCLM_CLAMAV_PORT=3310
FASTCLM_OCR_ENABLED=true
FASTCLM_OCR_LANGUAGE=eng
FASTCLM_BACKUP_ENCRYPTION_KEY=
FASTCLM_ALLOW_TEST_AUTH=true
FASTCLM_REQUIRE_EMAIL_VERIFICATION=false
FASTCLM_PLATFORM_ADMINS=

# Google OAuth / OpenID Connect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5025/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_ALLOWED_EMAILS=

# Token-gated integration API. Leave blank to disable data endpoints.
FASTCLM_API_TOKEN=
FASTCLM_SCIM_TOKEN=
# Optional fleet-standard alias; FASTCLM_API_TOKEN takes precedence.
FASTSME_API_TOKEN=

# AI review: five platform-funded requests per user, then BYOK.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4-1-fast-reasoning
FASTCLM_FREE_QUERY_LIMIT=5

# Transactional reminders
POSTMARK_API_TOKEN=
FROM_EMAIL=info@fastsme.com
FASTCLM_REMINDER_SCHEDULER_ENABLED=false
FASTCLM_REMINDER_INTERVAL_SECONDS=3600

# Electronic signature adapters (disabled until configured)
SIGNWELL_API_KEY=
SIGNWELL_TEST_MODE=true
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_PRIVATE_KEY=
